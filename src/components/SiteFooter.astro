---
import { pathFor, type Locale } from '../i18n';
import { guide } from '../content/guide';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const g = guide[locale];
const legalLinks = g.footer.legal.map((l) => ({ label: l.label, href: pathFor(locale, l.key) }));
---
<footer class="border-t-4 market-border bg-[#1f211e] text-[#f6efe3]">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 py-10 lg:grid-cols-[1.2fr_.8fr] lg:px-8">
    <div>
      <img src="/icons/logo.svg" alt="Mercado San Pedro — Guía cultural de Cusco" class="mb-5 h-14 w-auto rounded bg-[#fbf7ee] px-2" />
      <p class="max-w-3xl text-sm leading-7 text-white/75">{g.footer.disclaimer1}</p>
      <p class="mt-3 max-w-3xl text-sm leading-7 text-white/75">{g.footer.disclaimer2}</p>
      <p class="mt-3 text-sm text-white/60">Derechos de imagen: las fotografías pertenecen a sus autores originales y se utilizan conforme a sus licencias o condiciones de publicación.</p>
    </div>
    <div class="lg:text-right">
      <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm lg:justify-end">
        {legalLinks.map((l) => <a class="underline underline-offset-4" href={l.href}>{l.label}</a>)}
      </div>
      <p class="mt-8 text-sm text-white/60">{g.footer.copyright}</p>
      <p class="mt-2 text-xs text-white/45">{g.footer.sub}</p>
    </div>
  </div>
</footer>
