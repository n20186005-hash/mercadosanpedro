---
import { pathFor, otherLocale, langLabel, type Locale, type RouteKey } from '../i18n';
import { guide } from '../content/guide';
import { MAPS_SHARE_URL } from '../data/site';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}
const { locale, routeKey } = Astro.props;
const g = guide[locale];
const other = otherLocale(locale);
const homePath = pathFor(locale, 'home');
const subLinks = (['horario', 'comida', 'seguridad'] as RouteKey[]).map((k) => ({
  key: k,
  label: g.nav[k],
  href: pathFor(locale, k)
}));
const switchHref = pathFor(other, routeKey);
---
<header class="sticky top-0 z-40 border-b border-black/10 bg-[#fbf7ee]/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 lg:px-8">
    <a href={homePath} aria-label={g.nav.home} class="shrink-0"><img src="/icons/logo.svg" alt="Mercado San Pedro — Guía cultural de Cusco" class="h-12 w-auto" /></a>
    <nav aria-label="Navegación principal" class="hidden items-center gap-5 text-sm font-semibold md:flex">
      <a href={homePath} class="hover:text-[#b6442f]">{g.nav.home}</a>
      {subLinks.map((l) => <a href={l.href} class="hover:text-[#b6442f]">{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href={switchHref} rel="alternate" hreflang={other} class="rounded-full border border-black/15 px-3 py-1.5 text-xs font-bold text-black/70 hover:border-[#315d42] hover:text-[#315d42]">{langLabel[other].short}</a>
      <a href={MAPS_SHARE_URL} rel="noopener noreferrer" class="rounded-full bg-[#315d42] px-4 py-2 text-sm font-bold text-white hover:bg-[#264a35]">{g.nav.maps}</a>
    </div>
  </div>
</header>
