---
import { guide } from '../content/guide';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const r = guide[locale].responsibility;
---
<section id="responsabilidad" class="bg-[#1f211e] py-20 text-white">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[.2em] text-[#f1b83b]">{r.eyebrow}</p>
    <h2 class="display mt-3 max-w-4xl text-4xl font-bold sm:text-5xl">{r.h2}</h2>
    <p class="mt-4 max-w-3xl leading-8 text-white/80">{r.lead}</p>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {r.cards.map((c) => (
        <article class="rounded-3xl border border-white/15 bg-white/8 p-7">
          <h3 class="display text-2xl font-bold">{c.title}</h3>
          <p class="mt-3 text-sm leading-7 text-white/75">{c.body}</p>
        </article>
      ))}
    </div>

    <p class="mt-8 max-w-3xl text-sm leading-7 text-white/65">{r.note}</p>
  </div>
</section>
