---
import { guide } from '../content/guide';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = guide[locale].legal.cookies;
const f = d.form;
---
<main class="mx-auto max-w-4xl px-5 py-16 lg:px-8">
  <p class="text-sm font-bold uppercase tracking-[.2em] text-[#315d42]">{d.eyebrow}</p>
  <h1 class="display mt-3 text-5xl font-bold">{d.h1}</h1>
  <p class="mt-3 text-sm text-black/55">{d.updated}</p>
  <div class="prose-policy mt-10"><p>{d.intro}</p></div>
  <form id="cookie-form" class="mt-8 space-y-4">
    <section class="card rounded-3xl p-6"><div class="flex items-start justify-between gap-4"><div><h2 class="text-xl font-bold">{f.necessaryTitle}</h2><p class="mt-2 text-sm leading-7 text-black/65">{f.necessaryBody}</p></div><span class="pill shrink-0 rounded-full px-3 py-1 text-xs font-bold">{locale === 'es' ? 'Necesario' : 'Necessary'}</span></div></section>
    <section class="card rounded-3xl p-6"><label class="flex cursor-pointer items-start justify-between gap-5"><div><h2 class="text-xl font-bold">{f.analyticsTitle}</h2><p class="mt-2 text-sm leading-7 text-black/65">{f.analyticsBody}</p></div><input id="analytics" type="checkbox" class="mt-1 h-6 w-6 accent-[#315d42]" /></label></section>
    <p class="text-sm leading-7">{f.prefsBody}</p>
    <section class="card rounded-3xl p-6"><div class="flex items-start justify-between gap-4"><div><h2 class="text-xl font-bold">{f.marketingTitle}</h2><p class="mt-2 text-sm leading-7 text-black/65">{f.marketingBody}</p></div><span class="pill shrink-0 rounded-full px-3 py-1 text-xs font-bold">{locale === 'es' ? 'Inactivo' : 'Inactive'}</span></div></section>
    <div class="flex flex-wrap gap-3 pt-3"><button type="submit" class="rounded-full bg-[#315d42] px-6 py-3 font-bold text-white">{f.save}</button><button id="reject" type="button" class="rounded-full border border-black/20 px-6 py-3 font-bold">{f.reject}</button></div>
    <p id="status" class="text-sm font-semibold text-[#315d42]" aria-live="polite"></p>
  </form>
  <div class="prose-policy mt-10">
    {d.blocks.map((b) => (
      <div>
        <h2>{b.h2}</h2>
        {b.items.map((item) => item.type === 'p'
          ? <p>{item.text}</p>
          : <ul>{item.items.map((li) => <li>{li}</li>)}</ul>)}
      </div>
    ))}
  </div>
</main>
