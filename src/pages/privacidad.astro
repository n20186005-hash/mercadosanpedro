---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LegalPage from '../components/LegalPage.astro';
import { guide } from '../content/guide';
import { withSiteNameLocale } from '../data/site';
import type { Locale, RouteKey } from '../i18n';

const locale: Locale = 'es';
const routeKey: RouteKey = 'privacidad';
const d = guide[locale].legal.privacidad;
const title = withSiteNameLocale(d.h1, locale);
---
<BaseLayout title={title} description={d.intro} locale="es" routeKey="privacidad">
<SiteHeader locale="es" routeKey="privacidad" />
<LegalPage locale="es" legalKey="privacidad" />
<SiteFooter locale="es" />
</BaseLayout>
