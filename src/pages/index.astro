---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const faq = [
  ['¿La entrada al Mercado San Pedro tiene costo?','No. El ingreso al mercado es libre. Los alimentos, artesanías y demás productos se pagan directamente en cada puesto.'],
  ['¿Cuál es el mejor momento para visitarlo?','La mañana suele ofrecer una lectura más completa de la actividad cotidiana y de los productos frescos. Si deseas comer allí, el tramo entre media mañana y primeras horas de la tarde suele ser práctico.'],
  ['¿Cuánto tiempo conviene quedarse?','Reserva entre 60 y 90 minutos para recorrer con calma los pasillos; suma más tiempo si piensas sentarte a comer o conversar con comerciantes.'],
  ['¿Se puede fotografiar dentro?','Sí, pero por respeto conviene pedir permiso antes de fotografiar a personas o primeros planos de los puestos.'],
  ['¿Es recomendable llevar efectivo?','Sí. En un mercado tradicional muchos pagos siguen realizándose en soles y no todos los puestos aceptan tarjeta. Llevar billetes de baja denominación facilita compras pequeñas.'],
  ['¿Hay baños y servicios básicos?','El entorno del mercado cuenta con servicios urbanos y sanitarios, pero su disponibilidad, accesibilidad y condiciones pueden variar. Conviene confirmar in situ y llevar cambio.'],
  ['¿Está cerca del centro histórico?','Sí. Se encuentra en el barrio tradicional de San Pedro, dentro del Centro Histórico del Cusco y a una caminata corta del núcleo monumental.'],
  ['¿Cómo afecta la altura?','El mercado está en Cusco, a más de 3,000 m s. n. m. Camina a ritmo tranquilo, hidrátate y evita sobreesfuerzos si aún no te has aclimatado.']
];
const imageBase = 'https://upload.wikimedia.org/wikipedia/commons';
const hero = `${imageBase}/6/69/Fachada_Mercado_San_Pedro%2C_Cusco.jpg`;
const fruit = `${imageBase}/b/b5/Fruit_juices_heaven_at_the_Mercado_Central_de_San_Pedro.jpg`;
const inside = `${imageBase}/3/36/San_Pedro_Market_in_Cusco%2C_Peru.jpg`;
const mapEmbed='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6909.893352368979!2d-71.98524252298962!3d-13.520957686847316!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x916dd67664356669%3A0x66d1176e24a485a0!2sMercado%20Central%20de%20San%20Pedro!5e1!3m2!1ses!2spe!4v1787621448064!5m2!1ses!2spe';
const placeSchema = {
  '@context':'https://schema.org',
  '@type':['TouristAttraction','LocalBusiness'],
  name:'Mercado Central de San Pedro',
  description:'Mercado histórico de abastos del Centro Histórico del Cusco, reconocido por su vida cotidiana, productos andinos, comidas populares y artesanías.',
  ...(Astro.site ? {url:new URL('/',Astro.site).toString()} : {}),
  image:[inside],
  address:{'@type':'PostalAddress',streetAddress:'Ca. Thupaq Amaru 477',addressLocality:'Cusco',addressRegion:'Cusco',postalCode:'08002',addressCountry:'PE'},
  geo:{'@type':'GeoCoordinates',latitude:-13.520957686847316,longitude:-71.982647},
  aggregateRating:{'@type':'AggregateRating',ratingValue:'4.3',reviewCount:'45417'},
  openingHoursSpecification:[{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'06:00',closes:'18:00'}],
  isAccessibleForFree:true
};
const faqSchema = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<BaseLayout title="Mercado San Pedro Cusco | Guía cultural independiente" description="Guía cultural y práctica del Mercado Central de San Pedro en Cusco: historia, qué ver, comida tradicional, transporte, servicios, mapa y consejos de visita." structuredData={[placeSchema,faqSchema]}>
<SiteHeader />
<main>
  <section class="relative isolate min-h-[76vh] overflow-hidden bg-[#1f211e] text-white">
    <img src={hero} alt="Fachada del Mercado Central de San Pedro en Cusco" class="absolute inset-0 -z-20 h-full w-full object-cover" referrerpolicy="no-referrer" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/80 via-black/55 to-black/20"></div>
    <div class="mx-auto flex min-h-[76vh] max-w-7xl items-end px-5 pb-14 pt-24 lg:px-8 lg:pb-20">
      <div class="max-w-4xl"><p class="mb-4 inline-flex rounded-full border border-white/30 bg-black/25 px-4 py-2 text-sm font-bold backdrop-blur">Mercado histórico · Centro Histórico del Cusco</p><h1 class="display text-5xl font-bold leading-[.98] sm:text-7xl lg:text-8xl">San Pedro, el mercado donde Cusco sigue conversando.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-white/85">Frutas, panes, granos, hierbas, comidas populares y artesanía bajo una gran cubierta: una puerta directa a la vida cotidiana andina, a pocas cuadras del corazón monumental de la ciudad.</p><div class="mt-8 flex flex-wrap gap-3"><a href="#visita" class="rounded-full bg-[#f1b83b] px-6 py-3 font-bold text-[#241b0d]">Planificar la visita</a><a href="#historia" class="rounded-full border border-white/45 bg-white/10 px-6 py-3 font-bold backdrop-blur">Conocer su historia</a></div></div>
    </div>
  </section>

  <section class="border-y-4 market-border bg-[#f7e8c9]"><div class="mx-auto grid max-w-7xl gap-4 px-5 py-6 sm:grid-cols-2 lg:grid-cols-4 lg:px-8"><div><p class="text-xs font-bold uppercase tracking-[.18em] text-[#7d2f21]">Ingreso</p><p class="mt-1 text-xl font-bold">Libre</p></div><div><p class="text-xs font-bold uppercase tracking-[.18em] text-[#7d2f21]">Referencia de visita</p><p class="mt-1 text-xl font-bold">06:00–18:00</p><p class="text-xs text-black/60">Horario de referencia de inventario turístico; puede variar.</p></div><div><p class="text-xs font-bold uppercase tracking-[.18em] text-[#7d2f21]">Altitud</p><p class="mt-1 text-xl font-bold">≈ 3,400 m</p></div><div><p class="text-xs font-bold uppercase tracking-[.18em] text-[#7d2f21]">Dirección</p><p class="mt-1 font-bold">Ca. Thupaq Amaru 477, Cusco</p></div></div></section>

  <section id="historia" class="texture py-20"><div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[.9fr_1.1fr] lg:px-8"><div><p class="text-sm font-bold uppercase tracking-[.2em] text-[#b6442f]">Historia y contexto</p><h2 class="display mt-3 text-4xl font-bold sm:text-5xl">Un mercado moderno dentro de un barrio con siglos de memoria.</h2><p class="mt-6 leading-8 text-black/70">San Pedro es uno de los barrios tradicionales del centro histórico cusqueño. La documentación municipal recuerda que en este sector existió desde el siglo XVI el Hospital de Naturales y que el barrio fue consolidando una identidad propia alrededor de sus espacios religiosos, comerciales y de conexión con otras zonas de la ciudad.</p><p class="mt-4 leading-8 text-black/70">A comienzos del siglo XX, las autoridades impulsaron el traslado del abastecimiento que se realizaba en las plazas del centro hacia un recinto específico. El mercado fue inaugurado en 1925 durante la gestión municipal de Manuel Silvestre Frisancho, convirtiéndose en el mercado cerrado de abastos más antiguo del Cusco.</p><div class="mt-7 rounded-2xl border-l-4 border-[#315d42] bg-white/70 p-5"><p class="font-bold">Importante sobre la autoría arquitectónica</p><p class="mt-2 text-sm leading-7 text-black/65">La atribución popular a Gustave Eiffel aparece de forma muy extendida en guías y bases colaborativas. Para una guía de divulgación rigurosa conviene presentarla como una atribución discutida, no como un hecho documental inequívoco.</p></div></div><div class="grid gap-4 sm:grid-cols-2"><img src={inside} alt="Interior del Mercado San Pedro con puestos de frutas y visitantes" class="h-full min-h-80 w-full rounded-[2rem] object-cover sm:row-span-2" referrerpolicy="no-referrer"/><img src={fruit} alt="Puesto de jugos y frutas en el Mercado San Pedro" class="h-64 w-full rounded-[2rem] object-cover" referrerpolicy="no-referrer"/><div class="rounded-[2rem] bg-[#315d42] p-7 text-white"><p class="text-xs font-bold uppercase tracking-[.2em] text-white/60">Lectura cultural</p><p class="display mt-3 text-2xl font-bold">El valor del mercado está en observar relaciones, productos y ritmos cotidianos, no solo en comprar.</p></div></div></div></section>

  <section class="bg-[#315d42] py-20 text-white"><div class="mx-auto max-w-7xl px-5 lg:px-8"><p class="text-sm font-bold uppercase tracking-[.2em] text-[#f1b83b]">Qué observar</p><h2 class="display mt-3 max-w-4xl text-4xl font-bold sm:text-5xl">Una introducción práctica a la despensa de los Andes.</h2><div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">{[['Productos andinos','Papas nativas, maíz, quinua, habas, chuño y otros ingredientes que conectan el mercado con los pisos ecológicos de la región.'],['Jugos y frutas','Filas de puestos de jugos preparados al momento permiten reconocer frutas locales y productos llegados desde zonas más cálidas del país.'],['Comida cotidiana','Caldos, desayunos y platos populares muestran una cocina de mercado orientada tanto a trabajadores locales como a visitantes.'],['Textiles, hierbas y ritualidad','Tejidos, plantas medicinales, hojas de coca y objetos de uso simbólico ayudan a entender la continuidad de prácticas andinas.']].map(([t,d])=><article class="rounded-3xl border border-white/15 bg-white/8 p-6"><h3 class="display text-2xl font-bold">{t}</h3><p class="mt-3 text-sm leading-7 text-white/75">{d}</p></article>)}</div></div></section>

  <section id="visita" class="py-20"><div class="mx-auto max-w-7xl px-5 lg:px-8"><div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr]"><div><p class="text-sm font-bold uppercase tracking-[.2em] text-[#b6442f]">Planifica bien</p><h2 class="display mt-3 text-4xl font-bold sm:text-5xl">Cuándo ir y cuánto tiempo quedarse.</h2></div><div class="grid gap-5 sm:grid-cols-2"><article class="card rounded-3xl p-6"><h3 class="font-bold">Mejor franja: mañana</h3><p class="mt-2 leading-7 text-black/65">Para observar el abastecimiento, mayor variedad de productos frescos y un ritmo más local. Evita ir con prisa: los pasillos pueden estar concurridos.</p></article><article class="card rounded-3xl p-6"><h3 class="font-bold">Tiempo recomendado: 60–90 min</h3><p class="mt-2 leading-7 text-black/65">Suficiente para recorrer los sectores principales. Añade tiempo si vas a comer, tomar un jugo o conversar con vendedores.</p></article><article class="card rounded-3xl p-6"><h3 class="font-bold">Altura y clima</h3><p class="mt-2 leading-7 text-black/65">Cusco supera los 3,000 m s. n. m. Avanza despacio si acabas de llegar. El mercado es cubierto, pero las calles exteriores pueden ser frías y lluviosas según la temporada.</p></article><article class="card rounded-3xl p-6"><h3 class="font-bold">Dinero y respeto</h3><p class="mt-2 leading-7 text-black/65">Lleva soles y billetes pequeños. Pide permiso antes de fotografiar personas. Mantén tus pertenencias cerca en zonas de mucha circulación.</p></article></div></div></div></section>

  <section id="transporte" class="bg-[#efe6d7] py-20"><div class="mx-auto max-w-7xl px-5 lg:px-8"><p class="text-sm font-bold uppercase tracking-[.2em] text-[#315d42]">Transporte detallado</p><h2 class="display mt-3 text-4xl font-bold sm:text-5xl">Cómo llegar al Mercado San Pedro.</h2><div class="mt-10 grid gap-5 lg:grid-cols-4">{[['Desde el aeropuerto','Desde el Aeropuerto Internacional Alejandro Velasco Astete, taxi o vehículo por aplicación suele ser la opción más directa. El transporte público urbano también conecta el eje del aeropuerto con el centro; confirma la ruta y el paradero vigentes antes de subir.'],['En autobús urbano','Diversas rutas RTU/RTI pasan por Calle Nueva, Concevidayoc, Santa Clara y Av. del Ejército, a pocos minutos a pie. La red puede cambiar; verifica señalización y destino con el conductor o una fuente local actualizada.'],['En taxi','Indica “Mercado de San Pedro” o “Plazoleta San Pedro”. En horas de congestión, puede ser más eficiente bajar a unas cuadras y completar el tramo caminando. Acuerda tarifa cuando corresponda y usa servicios autorizados.'],['A pie y en tren','Desde la Plaza de Armas el recorrido peatonal es corto, por Mantas, Marqués y Santa Clara. La estación ferroviaria de San Pedro está frente/al lado del entorno del mercado y sirve de referencia urbana.']].map(([t,d])=><article class="rounded-3xl bg-white p-6"><h3 class="display text-2xl font-bold">{t}</h3><p class="mt-3 text-sm leading-7 text-black/65">{d}</p></article>)}</div><p class="mt-6 text-sm text-black/55">Los tiempos y rutas dependen del tránsito, obras y ajustes operativos. Para conexiones ferroviarias o aeroportuarias, verifica siempre la información del operador antes de viajar.</p></div></section>

  <section id="servicios" class="py-20"><div class="mx-auto max-w-7xl px-5 lg:px-8"><p class="text-sm font-bold uppercase tracking-[.2em] text-[#b6442f]">Servicios útiles, sin recomendaciones comerciales</p><h2 class="display mt-3 max-w-4xl text-4xl font-bold sm:text-5xl">Lo que conviene saber alrededor del mercado.</h2><div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{[['WC y lavamanos','Busca servicios higiénicos señalizados dentro o en equipamientos públicos del entorno. Llevar monedas y alcohol gel puede ser práctico.'],['Estacionamiento','El centro histórico tiene calles estrechas, regulación de tránsito y oferta limitada de estacionamiento. Si llegas en auto, prioriza estacionamientos formales en el perímetro y continúa a pie.'],['Alimentación','Dentro del mercado hay sectores de comida, panes, jugos y productos frescos. Para seguridad alimentaria, elige puestos con alta rotación, superficies limpias y alimentos bien cocidos.'],['Alojamiento','El centro de Cusco dispone de múltiples categorías de alojamiento. Compara ubicación, accesibilidad, políticas y registros en fuentes oficiales o plataformas independientes; esta guía no recomienda establecimientos concretos.'],['Compras y abarrotes','El propio mercado funciona como gran centro de abasto. En calles vecinas encontrarás tiendas y comercios de conveniencia; evita comprar productos regulados o de origen dudoso.'],['Combustible y carga','Las estaciones de combustible se ubican principalmente fuera del núcleo más peatonal del centro. Los puntos de carga para vehículos eléctricos son aún menos frecuentes; planifica la recarga con antelación.']].map(([t,d])=><article class="card rounded-3xl p-6"><h3 class="font-bold">{t}</h3><p class="mt-2 text-sm leading-7 text-black/65">{d}</p></article>)}</div></div></section>

  <section class="bg-[#b6442f] py-20 text-white"><div class="mx-auto max-w-7xl px-5 lg:px-8"><div class="grid gap-10 lg:grid-cols-2"><div><p class="text-sm font-bold uppercase tracking-[.2em] text-[#f6cf77]">Comer en los alrededores</p><h2 class="display mt-3 text-4xl font-bold">Sabores que puedes buscar, no locales que debas elegir.</h2><p class="mt-5 leading-8 text-white/80">Como guía sin fines de lucro, recomendamos categorías y criterios, no negocios concretos. En el área de San Pedro y el centro histórico puedes encontrar cocina cusqueña, menús del día, panadería tradicional, juguerías y propuestas de cocina peruana contemporánea.</p><div class="mt-6 flex flex-wrap gap-2">{['caldo y sopas','choclo y queso','tamales','pan chuta','jugos de fruta','quinua y granos andinos','platos de mercado'].map(x=><span class="rounded-full border border-white/30 px-3 py-2 text-sm">{x}</span>)}</div></div><div><p class="text-sm font-bold uppercase tracking-[.2em] text-[#f6cf77]">Cerca, a pie</p><h2 class="display mt-3 text-4xl font-bold">Otros lugares para entender Cusco.</h2><ul class="mt-6 space-y-4 text-white/80"><li><strong class="text-white">Plazoleta e Iglesia de San Pedro:</strong> el frente urbano inmediato del mercado y una clave para leer el barrio.</li><li><strong class="text-white">Arco y calle Santa Clara:</strong> corredor histórico hacia el centro, con arquitectura republicana y colonial.</li><li><strong class="text-white">Plaza San Francisco:</strong> gran espacio público entre San Pedro y el núcleo monumental.</li><li><strong class="text-white">Plaza de Armas y entorno monumental:</strong> centro cívico y simbólico del Cusco histórico.</li></ul></div></div></div></section>

  <section class="py-20"><div class="mx-auto max-w-7xl px-5 lg:px-8"><div class="grid gap-6 lg:grid-cols-3"><article class="rounded-3xl bg-[#f7e8c9] p-7"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#7d2f21]">Entrada y gastos</p><h2 class="display mt-2 text-3xl font-bold">Sin boleto de acceso</h2><p class="mt-4 leading-7 text-black/65">El mercado es un espacio de abasto con ingreso libre. Presupuesta solo tus consumos y compras. Evitamos publicar precios concretos porque cambian con producto, temporada y puesto.</p></article><article class="rounded-3xl bg-[#d9e7dd] p-7"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#315d42]">Compra responsable</p><h2 class="display mt-2 text-3xl font-bold">Pregunta, compara, respeta.</h2><p class="mt-4 leading-7 text-black/65">Consulta el precio antes de pedir, no manipules alimentos sin permiso y evita presionar para fotografiar. Si compras artesanía, pregunta por materiales y procedencia.</p></article><article class="rounded-3xl bg-[#dce7eb] p-7"><p class="text-xs font-bold uppercase tracking-[.18em] text-[#2b6375]">Seguridad práctica</p><h2 class="display mt-2 text-3xl font-bold">Atención a tus pertenencias.</h2><p class="mt-4 leading-7 text-black/65">Como en cualquier mercado concurrido, usa bolso cerrado, evita exhibir objetos de valor y mantén especial atención al cruzar calles alrededor del recinto.</p></article></div></div></section>

  <section class="bg-[#1f211e] py-20 text-white"><div class="mx-auto max-w-7xl px-5 lg:px-8"><div class="grid gap-8 lg:grid-cols-[.65fr_1.35fr]"><div><p class="text-sm font-bold uppercase tracking-[.2em] text-[#f1b83b]">Ubicación</p><h2 class="display mt-3 text-4xl font-bold">Mercado Central de San Pedro</h2><p class="mt-4 text-white/70">Ca. Thupaq Amaru 477, Cusco 08002, Perú</p><a href="https://maps.app.goo.gl/tG72Ybjn8motbpZR6" rel="noopener noreferrer" class="mt-6 inline-block rounded-full bg-[#f1b83b] px-5 py-3 font-bold text-[#241b0d]">Abrir en Google Maps</a></div><div class="overflow-hidden rounded-[2rem] border border-white/15"><iframe src={mapEmbed} title="Mapa del Mercado Central de San Pedro, Cusco" width="100%" height="450" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></div></div></section>

  <section id="faq" class="py-20"><div class="mx-auto max-w-5xl px-5 lg:px-8"><p class="text-sm font-bold uppercase tracking-[.2em] text-[#b6442f]">Preguntas frecuentes</p><h2 class="display mt-3 text-4xl font-bold sm:text-5xl">Antes de ir</h2><div class="mt-8 divide-y divide-black/10 border-y border-black/10">{faq.map(([q,a])=><details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold"><span>{q}</span><span class="text-xl group-open:rotate-45">+</span></summary><p class="max-w-3xl pt-3 leading-7 text-black/65">{a}</p></details>)}</div></div></section>

  <section class="bg-[#efe6d7] py-14"><div class="mx-auto max-w-7xl px-5 lg:px-8"><h2 class="display text-3xl font-bold">Fuentes y criterio editorial</h2><p class="mt-3 max-w-4xl leading-7 text-black/65">La ficha se elaboró contrastando el Inventario Nacional de Recursos Turísticos de MINCETUR, la catalogación del Centro Histórico de la Municipalidad Provincial del Cusco y fuentes públicas de movilidad. Los horarios, rutas y servicios pueden cambiar; los datos críticos deben verificarse antes de viajar.</p><p class="mt-4 text-sm text-black/55">Fotografías: fachada — Ordzonhyd Rudyard Tarco Palomino / Wikimedia Commons (CC BY 4.0); jugos — sergejf / Wikimedia Commons (CC BY 2.0); interior — Ashim D’Silva / Unsplash, archivo en Wikimedia Commons (CC0).</p></div></section>
</main>
<SiteFooter />
</BaseLayout>
