---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeContent from '../components/HomeContent.astro';
import { guide } from '../content/guide';
import {
  SITE_URL, ATTRACTION_FULL_NAME, ATTRACTION_SHORT_NAME, CITY_NAME, STATE_PROVINCE,
  COUNTRY_NAME, STREET_ADDRESS, POSTAL_CODE, COUNTRY_CODE_2LETTER,
  LATITUDE, LONGITUDE, MAPS_SHARE_URL, GOVT_TOURISM_URL,
  HERO_IMAGE
} from '../data/site';
import type { Locale } from '../i18n';

const locale: Locale = 'es';
const faq = guide[locale].home.faq.items;
const insideImg = `${SITE_URL}/images/interior.webp`;

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${SITE_URL}/#attraction`,
  name: ATTRACTION_FULL_NAME,
  alternateName: [ATTRACTION_SHORT_NAME, `${CITY_NAME} ${ATTRACTION_FULL_NAME}`],
  description: `Guía de visita completa del ${ATTRACTION_FULL_NAME} en ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}: historia, qué ver, comida, transporte, servicios, mapa y consejos.`,
  url: `${SITE_URL}/`,
  image: [HERO_IMAGE, insideImg],
  address: { '@type': 'PostalAddress', streetAddress: STREET_ADDRESS, addressLocality: CITY_NAME, addressRegion: STATE_PROVINCE, postalCode: POSTAL_CODE, addressCountry: COUNTRY_CODE_2LETTER },
  geo: { '@type': 'GeoCoordinates', latitude: LATITUDE, longitude: LONGITUDE },
  hasMap: MAPS_SHARE_URL,
  sameAs: [MAPS_SHARE_URL, GOVT_TOURISM_URL]
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<BaseLayout title="Mercado San Pedro Cusco: horarios, ubicación y comida" description="Guía independiente del Mercado San Pedro: horarios de referencia con fuentes, dirección, cómo llegar, comida, compras y consejos para la visita." locale="es" routeKey="home" structuredData={[placeSchema, faqSchema]}>
<SiteHeader locale="es" routeKey="home" />
<HomeContent locale="es" />
<SiteFooter locale="es" />
</BaseLayout>
