---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CookiesPage from '../components/CookiesPage.astro';
import { guide } from '../content/guide';
import { withSiteNameLocale } from '../data/site';
import type { Locale, RouteKey } from '../i18n';

const locale: Locale = 'es';
const routeKey: RouteKey = 'cookies';
const d = guide[locale].legal.cookies;
const title = withSiteNameLocale(d.h1, locale);
---
<BaseLayout title={title} description={d.intro} locale="es" routeKey="cookies">
<SiteHeader locale="es" routeKey="cookies" />
<CookiesPage locale="es" />
<SiteFooter locale="es" />
</BaseLayout>
