---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SubPage from '../components/SubPage.astro';
import { guide } from '../content/guide';
import { withSiteNameLocale } from '../data/site';
import { breadcrumbSchema, type Locale, type RouteKey } from '../i18n';

const locale: Locale = 'es';
const routeKey: RouteKey = 'seguridad';
const s = guide[locale].sub.seguridad;
const title = withSiteNameLocale(guide[locale].nav.seguridad, locale);
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const bc = breadcrumbSchema(locale, routeKey, Astro.site);
const structuredData = [bc, faqSchema].filter(Boolean);
---
<BaseLayout title={title} description={s.intro} locale="es" routeKey="seguridad" structuredData={structuredData}>
<SiteHeader locale="es" routeKey="seguridad" />
<SubPage locale="es" subKey="seguridad" />
<SiteFooter locale="es" />
</BaseLayout>
